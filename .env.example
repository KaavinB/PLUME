# Copy to .env. Every value here is safe for local development; none is a production secret.

# --- Backend (FastAPI) -----------------------------------------------------
PLUME_DATABASE_URL=postgresql+psycopg://plume:plume@localhost:5434/plume
PLUME_DATA_MODE=snapshot                 # snapshot (offline, default) | live
PLUME_DEMO_MODE=true                     # enables demo personas, simulated clock and reset (local chain only)
PLUME_JWT_SECRET=replace-with-32+-random-characters-for-anything-shared
PLUME_CORS_ORIGINS=["http://localhost:3000"]

# --- Blockchain -------------------------------------------------------------
PLUME_CHAIN_RPC_URL=http://127.0.0.1:8545
PLUME_CHAIN_ID=31337
PLUME_CHAIN_NAME=Anvil (local)
# PLUME_CHAIN_EXPLORER_URL=https://sepolia.basescan.org   # set for Base Sepolia
# PLUME_DEPLOYMENT_FILE=contracts/deployments/base-sepolia.json
# Demo persona keys are derived from this mnemonic. The default is the PUBLIC Anvil test mnemonic:
# never fund these addresses on a real network.
PLUME_DEMO_MNEMONIC=test test test test test test test test test test test junk

# --- Optional LLM narrative (deterministic template is used when unset) -----
PLUME_LLM_PROVIDER=none                  # none | anthropic
PLUME_LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# --- Optional Carbon Mapper token (public endpoints work without one) -------
# PLUME_CARBONMAPPER_TOKEN=
